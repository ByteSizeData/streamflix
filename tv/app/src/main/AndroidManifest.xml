<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Installing dx.bi TV updates the app downloads (Android asks first) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Play on TV: a phone sending a film wakes a sleeping TV that has the app on top (TvReceiver) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Downloads (Downloads.kt) keep going in the background, with their progress in a notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- A TV app first, but it installs on any Android device -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- largeHeap: the player keeps what it has loaded of the video in the app's own memory, about
         144 MB of it for a 4K film. A TV box allows an app 192 MB unless it asks for the large heap
         (512 MB on a SHIELD): with the page's share on top the app sat at 173 MB of 187 through a
         film. Past three quarters of the allowance Android destroys the app's screens that aren't
         showing (the main screen and its page, each film), and a skip that has the player load from
         a new place, anything past the ten seconds or so it holds, asks for more just when there is
         none: the player ends, or the app does. -->
    <application
        android:allowBackup="false"
        android:largeHeap="true"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dxbi">

        <!-- Both screens take every change of the screen themselves (configChanges). A TV coming on, an
             HDMI link settling or the HDR mode changing is a "colorMode" change, and Android answers
             a change that a screen doesn't take by destroying the screen and making it again: the
             player closed, and the main screen's page started over from Home. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|colorMode|density|fontScale|touchscreen|locale|layoutDirection|mcc|mnc|fontWeightAdjustment"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- stremio:// addon links -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="stremio" />
            </intent-filter>
        </activity>

        <!-- Starts dx.bi afresh after a long time away; a process of its own, so it outlives the one it replaces -->
        <activity
            android:name=".RestartActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:process=":restart"
            android:theme="@style/Theme.Dxbi" />

        <activity
            android:name=".PlayerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|colorMode|density|fontScale|touchscreen|locale|layoutDirection|mcc|mnc|fontWeightAdjustment"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Dxbi.Player" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
        <!-- Downloads, on phones and TVs (Downloads.kt) -->
        <service
            android:name=".DownloadsService"
            android:exported="false"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="androidx.media3.exoplayer.downloadService.action.RESTART" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
